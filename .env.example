# Copy to .env next to docker-compose.yml and adjust. Never commit .env.

# Database (used by both containers)
POSTGRES_USER=kontoplaner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kontoplaner

# Public URL of the app behind your reverse proxy (needed for logins and widget scripts)
ORIGIN=https://konto.example.lan

# Host port the app is published on (your reverse proxy forwards here)
APP_PORT=3000

# Key for encrypting stored credentials (SMTP password, Home Assistant token). Optional: without it
# the app creates /app/data/secret.key in the volume on first use. If you set it, keep it – a new
# key means entering the credentials again. Generate: openssl rand -base64 32
APP_SECRET=

# Before every database migration the app writes a pg_dump to /app/data/backups (volume app-data)
# and keeps the newest 10. Set to false only if a backup is impossible and you have another one.
# BACKUP_BEFORE_MIGRATION=true

# Company logos: for payees without a built-in logo the app fetches the icon from the company's
# website, or via Google's favicon service (only company domains are requested, no bookings).
# Set to false to keep the server from fetching logos from the web.
# WEB_LOGOS=true

# Local development only (pnpm dev): connection to the dev database from `pnpm db:up`
# DATABASE_URL=postgres://kontoplaner:kontoplaner@localhost:5432/kontoplaner
