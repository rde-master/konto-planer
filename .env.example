# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=kontoplaner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kontoplaner
DATABASE_URL=postgres://kontoplaner:change-me@db:5432/kontoplaner

# Public base URL behind the reverse proxy (used in widget scripts)
ORIGIN=https://konto.example.lan

# 32-byte key (base64) for encrypting stored credentials (SMTP, Home Assistant)
# generate: openssl rand -base64 32
APP_SECRET=

TZ=Europe/Berlin
