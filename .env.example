# Copy to .env next to docker-compose.yml and adjust. Never commit .env.

# Database (used by both containers)
POSTGRES_USER=kontoplaner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kontoplaner

# Public URL of the app behind your reverse proxy (needed for logins and widget scripts)
ORIGIN=https://konto.example.lan

# Host port the app is published on (your reverse proxy forwards here)
APP_PORT=3000

# 32-byte key for encrypting stored credentials (SMTP, Home Assistant); needed from 0.41.0
# generate: openssl rand -base64 32
APP_SECRET=

# Local development only (pnpm dev): connection to the dev database from `pnpm db:up`
# DATABASE_URL=postgres://kontoplaner:kontoplaner@localhost:5432/kontoplaner
